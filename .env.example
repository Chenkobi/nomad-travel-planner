TELEGRAM_BOT_TOKEN=put-your-token-here
# Optional: restrict the bot to Kobi's Telegram chat id
# TELEGRAM_ALLOWED_CHAT_ID=
# Optional: use Gemini vision for PDF extraction (keep the key only in UGREEN .env)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Production API boundary: set this on the server; leave unset for explicit local fallback.
# TRIPY_API_AUTH_TOKEN=
# Optional production frontend origin override.
# TRIPY_API_ALLOWED_ORIGIN=https://trip.atlasim.co.il
# Time-based trip reminders (push). Enabled by default; set to 0 to turn off.
# TRIPY_REMINDERS_ENABLED=1
# Fallback zone when a booking location is unknown.
# TRIPY_DEFAULT_TIMEZONE=Asia/Jerusalem
# Live flight status (AeroDataBox via RapidAPI). Set as a GitHub Actions secret; leave unset to disable.
# AERODATABOX_RAPIDAPI_KEY=
# TRIPY_FLIGHT_STATUS_MONTHLY_LIMIT=250
